                    "200": {
                        "description": ""
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ],
                "summary": "L\u2019utilisateur connect\u00e9",
                "tags": [
                    "auth"
                ]
            }
        },
        "/tasks": {
            "get": {
                "operationId": "TasksController_findAll",
                "parameters": [
                    {
                        "name": "page",
                        "required": false,
                        "in": "query",
                        "schema": {
                            "default": 1,
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/Object"
                                }
                            ]
                        }
                    },
                    {
                        "name": "limit",
                        "required": false,
                        "in": "query",
                        "schema": {
                            "maximum": 100,
                            "default": 10,
                            "allOf": [
                                {
                                    "$ref": "#/components/schemas/Object"
                                }
                            ]
                        }
                    },
                    {
                        "name": "done",
                        "required": false,
                        "in": "query",
                        "description": "Filtrer sur l\u2019\u00e9tat termin\u00e9",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "categoryId",
                        "required": false,
                        "in": "query",
                        "schema": {
                            "type": "number"
                        }
                    },
                    {
                        "name": "priority",
                        "required": false,
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "LOW",
                                "MEDIUM",
                                "HIGH"
                            ]
                        }
                    },
                    {
                        "name": "q",
                        "required": false,
                        "in": "query",
                        "description": "Recherche dans le titre (insensible \u00e0 la casse)",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sortBy",
                        "required": false,
                        "in": "query",
                        "schema": {
                            "default": "createdAt",
                            "type": "string",
                            "enum": [
                                "createdAt",
                                "updatedAt",
                                "dueDate",
                                "priority",
                                "title",
                                "id"
                            ]
                        }
                    },
                    {
                        "name": "sort",
                        "required": false,
                        "in": "query",
                        "description": "Sens du tri (compatible avec le cours NestJS)",
                        "schema": {
                            "default": "desc",
                            "type": "string",
                            "enum": [
                                "asc",
                                "desc"
                            ]
                        }
                    },
                    {
                        "name": "clientId",
                        "required": false,
                        "in": "query",
                        "description": "Retrouver une t\u00e2che par son identifiant client",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ],
                "summary": "Lister ses t\u00e2ches (pagin\u00e9, filtrable, triable)",
                "tags": [
                    "tasks"
                ]
            },
            "post": {
                "operationId": "TasksController_create",
                "parameters": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateTaskDto"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": ""
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ],
                "summary": "Cr\u00e9er une t\u00e2che (idempotent si clientId est fourni)",
                "tags": [
                    "tasks"
                ]
            }
        },
        "/tasks/{id}": {
            "get": {
                "operationId": "TasksController_findOne",
                "parameters": [
                    {
                        "name": "id",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "type": "number"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ],
                "summary": "Une t\u00e2che",
                "tags": [
                    "tasks"
                ]
            },
            "patch": {
                "operationId": "TasksController_update",
                "parameters": [
                    {
                        "name": "id",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "type": "number"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateTaskDto"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": ""
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ],
                "summary": "Modifier une t\u00e2che (partiellement)",
                "tags": [
                    "tasks"
                ]
            },
            "delete": {
                "operationId": "TasksController_remove",
                "parameters": [
                    {
                        "name": "id",
                        "required": true,
                        "in": "path",
                        "schema": {
                            "type": "number"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": ""
                    }
                },
                "security": [
                    {
                        "bearer": []
                    }
                ],
                "summary": "Supprimer une t\u00e2che (renvoie la t\u00e2che supprim\u00e9e)",
                "tags": [
                    "tasks"
                ]
            }
        }
    },
    "info": {
        "title": "TaskyAPI",
        "description": "API de r\u00e9f\u00e9rence du cours \u00ab Tasky Web : De Flutter au Web \u00bb",
        "version": "1.0.0",
        "contact": {}
    },
    "tags": [],
    "servers": [],
    "components": {
        "securitySchemes": {
            "bearer": {
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "type": "http"
            }
        },
        "schemas": {
            "RegisterDto": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Awa Dossou"
                    },
                    "email": {
                        "type": "string",
                        "example": "awa@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "MotDePasse2026",
                        "minLength": 8
                    }
                },
                "required": [
                    "name",
                    "email",
                    "password"
                ]
            },
            "VerifyOtpDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "awa@example.com"
                    },
                    "code": {
                        "type": "string",
                        "example": "123456"
                    }
                },
                "required": [
                    "email",
                    "code"
                ]
            },
            "ResendOtpDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "awa@example.com"
                    }
                },
                "required": [
                    "email"
                ]
            },
            "LoginDto": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "demo@tasky.dev"
                    },
                    "password": {
                        "type": "string",
                        "example": "Tasky2026!"
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "RefreshDto": {
                "type": "object",
                "properties": {
                    "refresh_token": {
                        "type": "string",
                        "description": "Mode \u00ab body \u00bb uniquement. En mode cookie, le jeton est lu dans le cookie tasky_refresh."
                    }
                }
            },
            "Object": {
                "type": "object",
                "properties": {}
            },
            "CreateTaskDto": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "Acheter du pain",
                        "maxLength": 200
                    },
                    "description": {
                        "type": "object",
                        "example": "Pain complet, \u00e0 la boulangerie du coin",
                        "maxLength": 2000,
                        "nullable": true
                    },
                    "dueDate": {
                        "type": "object",
                        "example": "2026-09-30",
                        "description": "Date au format AAAA-MM-JJ",
                        "nullable": true
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "LOW",
                            "MEDIUM",
                            "HIGH"
                        ],
                        "default": "MEDIUM"
                    },
                    "categoryId": {
                        "type": "object",
                        "example": 3,
                        "nullable": true
                    },
                    "clientId": {
                        "type": "string",
                        "description": "Identifiant g\u00e9n\u00e9r\u00e9 par le client (UUID), pour le mode hors ligne"
                    },
                    "done": {
                        "type": "boolean",
                        "default": false
                    }
                },
                "required": [
                    "title"
                ]
            },
            "UpdateTaskDto": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "Acheter du pain",
                        "maxLength": 200
                    },
                    "description": {
                        "type": "object",
                        "example": "Pain complet, \u00e0 la boulangerie du coin",
                        "maxLength": 2000,
                        "nullable": true
                    },
                    "dueDate": {
                        "type": "object",
                        "example": "2026-09-30",
                        "description": "Date au format AAAA-MM-JJ",
                        "nullable": true
                    },
                    "priority": {
                        "type": "string",
                        "enum": [
                            "LOW",
                            "MEDIUM",
                            "HIGH"
                        ],
                        "default": "MEDIUM"
                    },
                    "categoryId": {
                        "type": "object",
                        "example": 3,
                        "nullable": true
                    },
                    "clientId": {
                        "type": "string",
                        "description": "Identifiant g\u00e9n\u00e9r\u00e9 par le client (UUID), pour le mode hors ligne"
                    },
                    "done": {
                        "type": "boolean",
                        "default": false
                    }
                }
            }
        }
    }
}
